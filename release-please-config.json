{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "ai-toolkit",
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Changed" },
        { "type": "revert", "section": "Changed" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "hidden": true },
        { "type": "ci", "hidden": true },
        { "type": "build", "hidden": true },
        { "type": "refactor", "hidden": true },
        { "type": "test", "hidden": true },
        { "type": "style", "hidden": true }
      ],
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name=='revenuecat')].version" },
        { "type": "json", "path": ".claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".cursor-plugin/marketplace.json", "jsonpath": "$.metadata.version" },
        { "type": "json", "path": "revenuecat/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "revenuecat/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "revenuecat/.codex-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "revenuecat/.cursor-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "revenuecat/gemini-extension.json", "jsonpath": "$.version" }
      ]
    }
  }
}
